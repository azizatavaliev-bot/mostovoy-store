{
  "name": "mostovoy-store",
  "version": "1.0.0",
  "description": "МОСТОВОЙ — каталог техники с автосинхронизацией из Telegram-канала",
  "private": true,
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently -n backend,frontend -c cyan,magenta \"node --watch server/index.js\" \"npm run dev --prefix frontend\"",
    "build": "npm ci --prefix frontend && npm run build --prefix frontend",
    "migrate": "node server/cli/migrate.js",
    "resync": "node server/cli/resync.js",
    "import-channel": "node server/cli/import-public-channel.js",
    "detect-chat": "node server/cli/detect-chat.js",
    "set-webhook": "node server/cli/set-webhook.js",
    "admin": "node server/cli/admin.js",
    "admin:set-password": "node server/cli/set-admin-password.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\""
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "express": "^4.21.2",
    "multer": "^2.2.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
